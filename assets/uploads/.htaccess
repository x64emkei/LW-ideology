# Prevent script execution in uploads directory
<FilesMatch "(?i)\.(php|php3|php4|php5|phtml|pl|py|cgi|sh|bash|exe|bat|cmd)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Disable PHP execution
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
